[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = PspDriver.cat
DriverVer   = 06/12/2026,3.0.0.3

[DestinationDirs]
DefaultDestDir = 13
Firmware_Files = 13,System32\drivers\bc-250

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
PspDriver.sys = 1
Asd.bin = 1,,firmware
Ta.bin = 1,,firmware
Sysdrv.bin = 1,,firmware
Sos.bin = 1,,firmware
Smu.bin = 1,,firmware

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceDesc% = Psp_Device_Install, PCI\VEN_1022&DEV_143E&SUBSYS_00001022&REV_00

[Psp_Device_Install.NT]
CopyFiles = Drivers_Dir, Firmware_Files

[Drivers_Dir]
PspDriver.sys

[Firmware_Files]
Asd.bin
Ta.bin
Sysdrv.bin
Sos.bin
Smu.bin

[Psp_Device_Install.NT.Services]
AddService = PspDriver,%SPSVCINST_ASSOCSERVICE%,Psp_Service_Inst

[Psp_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\PspDriver.sys



[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName       = "AMD BC-250 Custom Lab"
DeviceDesc             = "AMD BC-250 PSP Driver Interface"
ServiceDesc            = "AMD BC-250 PSP Driver Service"
DiskName               = "AMD BC-250 PSP Driver Installation Disk"
